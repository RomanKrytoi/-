number = input("Введите число:").upper()
isstepeni = int(input("Введите степень:"))
vsistemy = int(input("В какую степень:"))
a="0123456789ABCDEF"
def perevod(number, isstepeni, vsistemy, a, st=len(number)-1, r=0):
    for i in number:
        r+=a.find(i)*isstepeni**st
        st-=1
    if vsistemy == 10:
        return(r)
    else:
        e=""
        while r>=vsistemy:
            e+=str(r%vsistemy)
            r=r//vsistemy
            e+=str(r)
            return(e[::-1])
print(perevod(number, isstepeni, vsistemy))
